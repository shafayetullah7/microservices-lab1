# Copy to .env in the project root.
# pnpm db:up   (services wait for Postgres on boot — up to ~30s)
# pnpm start:order | pnpm start:inventory
# After adding tables: pnpm db:order:generate && pnpm db:order:migrate

# HTTP port (order default 3001, inventory default 3000 if unset)
PORT=3001
INVENTORY_SERVICE_URL=http://127.0.0.1:3000
INVENTORY_HTTP_TIMEOUT_MS=3000

# OpenAPI UI at /api (off in production unless SWAGGER_ENABLED=true)
# SWAGGER_ENABLED=true

# Inventory lab only (Day 3 Step 5 — keep 0 outside local experiments)
# RESERVATION_PROCESSING_DELAY_MS=5000
# RESERVATION_RESPONSE_DELAY_MS=5000

# RabbitMQ (pnpm db:up / compose — management UI http://127.0.0.1:15672, login lab/lab)
# Set RABBITMQ_ENABLED=false to skip broker (e2e tests do this automatically).
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://lab:lab@127.0.0.1:5672
ORDER_EVENTS_EXCHANGE=orders.events
ORDER_CREATED_ROUTING_KEY=order.created
ORDER_CREATED_QUEUE=order.created.log

# Nest on the host (published ports 15433 / 15434)
ORDER_DATABASE_URL=postgresql://order_user:order_password@127.0.0.1:15433/orders_db
INVENTORY_DATABASE_URL=postgresql://inventory_user:inventory_password@127.0.0.1:15434/inventory_db

# Other services in the same compose file (container port 5432)
# ORDER_DATABASE_URL=postgresql://order_user:order_password@order-db:5432/orders_db
# INVENTORY_DATABASE_URL=postgresql://inventory_user:inventory_password@inventory-db:5432/inventory_db
