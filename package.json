{
  "name": "order-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start order-service",
    "start:dev": "nest start order-service --watch",
    "start:debug": "nest start order-service --debug --watch",
    "start:prod": "node dist/apps/order-service/main",
    "start:order": "nest start order-service --watch",
    "start:order:debug": "nest start order-service --debug --watch",
    "start:order:prod": "node dist/apps/order-service/main",
    "start:inventory": "nest start inventory-service --watch",
    "start:inventory:debug": "nest start inventory-service --debug --watch",
    "start:inventory:prod": "node dist/apps/inventory-service/main",
    "build:order": "nest build order-service",
    "build:inventory": "nest build inventory-service",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker compose -f infrastructure/docker/compose.yaml up -d",
    "db:down": "docker compose -f infrastructure/docker/compose.yaml down",
    "db:order:generate": "drizzle-kit generate --config=drizzle.config.order.ts",
    "db:order:migrate": "drizzle-kit migrate --config=drizzle.config.order.ts",
    "db:order:push": "drizzle-kit push --config=drizzle.config.order.ts",
    "db:inventory:generate": "drizzle-kit generate --config=drizzle.config.inventory.ts",
    "db:inventory:migrate": "drizzle-kit migrate --config=drizzle.config.inventory.ts",
    "db:inventory:push": "drizzle-kit push --config=drizzle.config.inventory.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "axios": "^1.21.1",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^1.0.0-rc.5",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}